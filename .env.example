# Copy this file to ".env" and fill in your own values.
# See README.md -> "Viewing login-walled or private posts" for how to get these.
#
# Everything here is OPTIONAL. Most public photos, carousels, and videos/Reels
# work with no .env file at all. Only add these if a specific link fails with
# a "requires logging in" style message.

INSTAGRAM_SESSIONID=
INSTAGRAM_DS_USER_ID=
INSTAGRAM_CSRFTOKEN=

# Advanced / maintenance only — see README.md "If this ever stops working".
# Leave blank to use the built-in default.
IG_DOC_ID=

# If Google Chrome/Edge is installed somewhere non-standard, point at it here
# so the fallback browser method can find it. Leave blank to auto-detect.
CHROME_PATH=

PORT=3000
